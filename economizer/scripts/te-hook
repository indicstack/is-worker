#!/bin/sh
# is-worker's token economizer (vendored microsoft/TokenEconomizer) hook launcher. Runs the hook
# dispatcher under the first Python >= 3.10 found; with none it answers "no change", so a missing
# Python never breaks a session (doctor reports it).
dir=$(CDPATH= cd -- "${0%/*}" && pwd)
for py in "${TE_PYTHON:-}" python3.13 python3.12 python3.11 python3.10 /opt/homebrew/bin/python3 /usr/local/bin/python3 python3 python; do
  if [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    if [ "${IW_TE_ENTRY:-hook}" = hook ]; then exec "$py" "$dir/iw_gate.py" "$@"; fi
    exec "$py" "$dir/te_bootstrap.py" "$IW_TE_ENTRY" "$@"
  fi
done
while IFS= read -r _line; do :; done
echo '{}'
